SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
JWT_SECRET=<long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))">
JWT_EXPIRES_HOURS=168
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WooCommerce store that receives orders (WooCommerce > Settings > Advanced > REST API, Read/Write key)
WC_URL=https://pelectro.org
WC_KEY=ck_...
WC_SECRET=cs_...
# Hidden "Custom PCB" placeholder product that order lines are attached to
WC_PRODUCT_ID=6309
# Private Supabase Storage bucket for uploaded Gerber zips (created automatically)
GERBER_BUCKET=gerbers
# Largest Gerber zip in MB, and whether the browser sends it straight to storage (needed on Vercel)
MAX_UPLOAD_MB=50
DIRECT_UPLOAD=true
# Shared secret for the WooCommerce webhook (WooCommerce > Settings > Advanced > Webhooks).
# Use the same value in the webhook's Secret field. Delivery URL: https://<this app>/api/woo/webhook
WC_WEBHOOK_SECRET=<long random string>
